# 200 m x 200 m ground quad. UVs run 0..40, so with repeat addressing the
# texture tiles every 5 m (see generate_ground_texture.py for why it exists).
v -100.0 -100.0 0.0
v  100.0 -100.0 0.0
v  100.0  100.0 0.0
v -100.0  100.0 0.0
vt 0.0 0.0
vt 40.0 0.0
vt 40.0 40.0
vt 0.0 40.0
vn 0.0 0.0 1.0
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
